PORT=8787
HOST=0.0.0.0
TENANTS_DIR=./tenants
DATA_DIR=./data
# AI: null = KB Q&A only | local = fine-tuned model on :8090 (no cloud) | openai-compatible = cloud
AI_PROVIDER=null
AI_API_KEY=local
AI_BASE_URL=http://127.0.0.1:8090/v1
AI_MODEL=acocam-lora
# ACOCAM logistics API (existing Node backend from api/api.json — NOT the WordPress site URL)
# Local dev (when logistics API runs on your machine):
# ACOCAM_API_BASE_URL=http://localhost:3019
# Live Hostinger API (must respond at /api/health — NOT acocamtrading.ca WordPress):
ACOCAM_API_BASE_URL=https://mediumblue-jackal-717379.hostingersite.com
# Optional portal URL overrides (defaults come from tenants/acocam/settings.json)
ACOCAM_PORTAL_LOGIN_URL=https://acocamtrading.ca/login
# Signup uses the same page as login on acocamtrading.ca (optional override)
ACOCAM_PORTAL_SIGNUP_URL=https://acocamtrading.ca/login
ACOCAM_PORTAL_QUOTE_URL=https://acocamtrading.ca/get-quote/
RATE_LIMIT_PER_MINUTE=60
