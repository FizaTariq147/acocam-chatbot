{
  "name": "@agent-platform/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build -w @agent-platform/sdk-js",
    "prestart": "npm run build -w @agent-platform/sdk-js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "reindex": "tsx src/reindex.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-platform/application": "*",
    "@agent-platform/domain": "*",
    "@agent-platform/engines": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
