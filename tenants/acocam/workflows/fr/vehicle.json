    { "id": "destination", "prompt": "Ville / pays de destination ?", "required": true, "validator": "text" },
    { "id": "condition", "prompt": "État / remarques (roulant ou non) ?", "required": true, "validator": "text" },
    { "id": "contact_email", "prompt": "Courriel de suivi ?", "required": true, "validator": "email" }
